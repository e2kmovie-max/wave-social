{
  "name": "wave-social",
  "private": true,
  "version": "0.1.0",
  "description": "Wave social service: rooms, chat, required-channel gates, statuses and playback sync state.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun build packages/social/src/index.ts --target bun --outdir dist/social",
    "lint": "bun --filter \"*\" lint",
    "typecheck": "bun --filter \"*\" typecheck",
    "test": "bun test packages/shared/test/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.13"
}
